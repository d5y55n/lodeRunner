[Unit]
Description=LodeRunner FastAPI dashboard
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/loderunner
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=loderunner
Group=loderunner
WorkingDirectory=/opt/loderunner/backend
EnvironmentFile=/etc/loderunner/loderunner.env
ExecStartPre=/usr/bin/test -L /opt/loderunner/data/live-dashboard
ExecStartPre=/usr/bin/test -w /var/lib/loderunner/live-dashboard
ExecStart=/opt/loderunner/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8011 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --timeout-graceful-shutdown 150
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/loderunner
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryHigh=1400M
MemoryMax=1700M
TasksMax=128
StandardOutput=journal
StandardError=journal
SyslogIdentifier=loderunner

[Install]
WantedBy=multi-user.target
