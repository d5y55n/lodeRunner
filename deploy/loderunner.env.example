# Installed as /etc/loderunner/loderunner.env, root:root 0600.
# systemd EnvironmentFile syntax, not a shell script. Do not use export.
# Leave empty to display YouTube unconfigured; never commit a real key.
YOUTUBE_API_KEY=
YOUTUBE_POLL_SECONDS=3600
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
